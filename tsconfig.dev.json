{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".dev-build",
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": [
    "src/content/types.ts",
    "src/content/historical.ts",
    "src/content/loader/**/*.ts",
    "src/engine/**/*.ts",
    "scripts/audit-content.ts",
    "scripts/validate.ts",
    "scripts/dev/**/*.ts"
  ]
}
